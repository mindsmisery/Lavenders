<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Blue-leaning pastel lavender palette -->
    <Color x:Key="LavenderPrimary">#AFA9E8</Color>
    <Color x:Key="LavenderDeep">#6F68B5</Color>
    <Color x:Key="LavenderAccent">#C9C5F4</Color>
    <Color x:Key="LavenderSoft">#FAF9FF</Color>
    <Color x:Key="LavenderMist">#F0EEFC</Color>
    <Color x:Key="LavenderBorder">#DDD9F2</Color>
    <Color x:Key="LavenderText">#343149</Color>
    <Color x:Key="LavenderMutedText">#747087</Color>
    <Color x:Key="LavenderWeekend">#F0EBFF</Color>
    <Color x:Key="LavenderOutsideMonth">#F1EFF5</Color>
    <Color x:Key="LavenderToday">#E8E5FF</Color>
    <Color x:Key="LavenderDanger">#B9657B</Color>
    <Color x:Key="LavenderErrorSurface">#FFF2F5</Color>
    <Color x:Key="LavenderErrorBorder">#E7BCC8</Color>
    <Color x:Key="LavenderSuccess">#527A64</Color>
    <Color x:Key="LavenderSuccessSurface">#EFF8F3</Color>
    <Color x:Key="LavenderSuccessBorder">#BFDDCB</Color>
    <Color x:Key="LavenderButtonHover">#9B91DE</Color>
    <Color x:Key="LavenderButtonPressed">#867CCB</Color>

    <SolidColorBrush x:Key="LavenderPrimaryBrush" Color="{DynamicResource LavenderPrimary}"/>
    <SolidColorBrush x:Key="LavenderDeepBrush" Color="{DynamicResource LavenderDeep}"/>
    <SolidColorBrush x:Key="LavenderAccentBrush" Color="{DynamicResource LavenderAccent}"/>
    <SolidColorBrush x:Key="LavenderSoftBrush" Color="{DynamicResource LavenderSoft}"/>
    <SolidColorBrush x:Key="LavenderMistBrush" Color="{DynamicResource LavenderMist}"/>
    <SolidColorBrush x:Key="LavenderBorderBrush" Color="{DynamicResource LavenderBorder}"/>
    <SolidColorBrush x:Key="LavenderTextBrush" Color="{DynamicResource LavenderText}"/>
    <SolidColorBrush x:Key="LavenderMutedTextBrush" Color="{DynamicResource LavenderMutedText}"/>
    <SolidColorBrush x:Key="LavenderWeekendBrush" Color="{DynamicResource LavenderWeekend}"/>
    <SolidColorBrush x:Key="LavenderOutsideMonthBrush" Color="{DynamicResource LavenderOutsideMonth}"/>
    <SolidColorBrush x:Key="LavenderTodayBrush" Color="{DynamicResource LavenderToday}"/>
    <SolidColorBrush x:Key="LavenderDangerBrush" Color="{DynamicResource LavenderDanger}"/>
    <SolidColorBrush x:Key="LavenderErrorSurfaceBrush" Color="{DynamicResource LavenderErrorSurface}"/>
    <SolidColorBrush x:Key="LavenderErrorBorderBrush" Color="{DynamicResource LavenderErrorBorder}"/>
    <SolidColorBrush x:Key="LavenderSuccessBrush" Color="{DynamicResource LavenderSuccess}"/>
    <SolidColorBrush x:Key="LavenderSuccessSurfaceBrush" Color="{DynamicResource LavenderSuccessSurface}"/>
    <SolidColorBrush x:Key="LavenderSuccessBorderBrush" Color="{DynamicResource LavenderSuccessBorder}"/>
    <SolidColorBrush x:Key="LavenderButtonHoverBrush" Color="{DynamicResource LavenderButtonHover}"/>
    <SolidColorBrush x:Key="LavenderButtonPressedBrush" Color="{DynamicResource LavenderButtonPressed}"/>
    <SolidColorBrush x:Key="LavenderCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LavenderInputSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LavenderEventSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LavenderOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LavenderLoadingOverlayBrush" Color="#B8FAF9FF"/>

    <!-- Segoe UI Variable is soft, highly legible, and ships with current Windows. -->
    <FontFamily x:Key="LavendersFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <LinearGradientBrush x:Key="LavenderBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCFBFF" Offset="0"/>
        <GradientStop Color="#F0EEFC" Offset="0.55"/>
        <GradientStop Color="#E9E7F8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LavenderDayGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F8F7FE" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LavenderButtonGradient" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#9D94E0" Offset="0"/>
        <GradientStop Color="#B8B1ED" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="SoftLavenderShadow"
                      BlurRadius="16" ShadowDepth="2" Opacity="0.13" Color="#5B567F"/>
    <DropShadowEffect x:Key="SoftButtonShadow"
                      BlurRadius="10" ShadowDepth="2" Opacity="0.16" Color="#655E99"/>

    <Style x:Key="LavenderCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LavenderCardBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LavenderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource SoftLavenderShadow}"/>
    </Style>

    <Style x:Key="LavenderToggleSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="54"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="54" Height="32" CornerRadius="16"
                                VerticalAlignment="Center" Background="{DynamicResource LavenderMistBrush}"
                                BorderBrush="{DynamicResource LavenderBorderBrush}" BorderThickness="1.5">
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Margin="4"
                                     HorizontalAlignment="Left" Fill="{DynamicResource LavenderCardBrush}"
                                     Effect="{StaticResource SoftButtonShadow}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource LavenderPrimaryBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource LavenderDeepBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource LavenderDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="2.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavenderButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource LavenderButtonGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderOnPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource LavendersFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource SoftButtonShadow}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LavenderButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LavenderButtonPressedBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.94"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource LavenderOnPrimaryBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavenderIconButton" TargetType="Button" BasedOn="{StaticResource LavenderButton}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LavenderSecondaryButton" TargetType="Button" BasedOn="{StaticResource LavenderButton}">
        <Setter Property="Background" Value="{DynamicResource LavenderCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LavenderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource SoftButtonShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LavenderMistBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource LavenderAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LavenderAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource LavenderDeepBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet, borderless actions used only by the main navigation surfaces. -->
    <Style x:Key="LavenderNavigationButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderMutedTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LavenderDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.58"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LavenderDeepBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavenderWeekActionButton"
           TargetType="Button"
           BasedOn="{StaticResource LavenderNavigationButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderDeepBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource LavendersFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="LavenderTimeStepButton" TargetType="Button" BasedOn="{StaticResource LavenderSecondaryButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="LavenderInputField" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource LavenderInputSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LavenderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource LavenderMutedTextBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource LavenderDeepBrush}"/>
                            <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource LavenderDangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavenderInputCombo" TargetType="ComboBox"
           BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Background" Value="{DynamicResource LavenderInputSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LavenderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{DynamicResource LavenderInputSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource LavenderTextBrush}"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LavenderMistBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LavenderAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavenderDatePicker" TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource LavenderInputSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LavenderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="CalendarStyle" Value="{DynamicResource LavenderCalendar}"/>
    </Style>

    <Style x:Key="LavenderDateBox" TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="LavenderCalendar" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource LavenderCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LavenderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource LavendersFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource LavenderTextBrush}"/>
    </Style>

    <Style x:Key="LavenderTimeSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource LavenderDeepBrush}"/>
        <Setter Property="Background" Value="{DynamicResource LavenderMistBrush}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickPlacement" Value="None"/>
    </Style>

</ResourceDictionary>
