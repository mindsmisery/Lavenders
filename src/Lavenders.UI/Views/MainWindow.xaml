<Window x:Class="Lavenders.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="{DynamicResource AppTitle}"
        Icon="pack://application:,,,/Assets/Lavenders.ico"
        Height="800" Width="1500"
        MinWidth="1200" MinHeight="700"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource LavenderBackgroundGradient}"
        FontFamily="{DynamicResource LavendersFont}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource LavenderCardBrush}"
                BorderBrush="{DynamicResource LavenderBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="15,20"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource SlideLeft}"/>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Button Command="{Binding HomeCommand}"
                        Style="{DynamicResource LavenderNavigationButton}"
                        Margin="0,0,0,12"
                        ToolTip="{DynamicResource Calendar}"
                        AutomationProperties.Name="{DynamicResource Calendar}">
                    <fa:IconBlock Icon="Home" FontSize="19"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding SettingsCommand}"
                        Style="{DynamicResource LavenderNavigationButton}"
                        Margin="0"
                        ToolTip="{DynamicResource Settings}"
                        AutomationProperties.Name="{DynamicResource Settings}">
                    <fa:IconBlock Icon="Gear" FontSize="19"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="12"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform><TranslateTransform/></ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource SlideUp}"/>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <Border Grid.Column="1" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="20" Padding="16,12" CornerRadius="14"
                Background="{DynamicResource LavenderCardBrush}"
                BorderBrush="{DynamicResource LavenderPrimaryBrush}" BorderThickness="1"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                Effect="{StaticResource SoftLavenderShadow}">
            <StackPanel Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{DynamicResource UpdateAvailable}" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource LavenderMutedTextBrush}" FontSize="12">
                        <Run Text="{DynamicResource VersionLabel}"/><Run Text=" "/><Run Text="{Binding AvailableVersion}"/>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource UpdateInstallFailed}" Margin="0,3,0,0"
                               Foreground="{DynamicResource LavenderDangerBrush}" FontSize="12"
                               Visibility="{Binding HasUpdateError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <Button Command="{Binding InstallUpdateCommand}" Style="{DynamicResource LavenderButton}"
                        MinWidth="145" Padding="14,8">
                    <TextBlock Text="{DynamicResource UpdateAndRestart}"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
