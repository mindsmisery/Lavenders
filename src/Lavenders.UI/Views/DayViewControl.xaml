<UserControl x:Class="Lavenders.UI.Views.DayViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lavenders.UI.ViewModels"
             xmlns:core="clr-namespace:Lavenders.Core.Models;assembly=Lavenders.Core"
             Background="Transparent"
             FontFamily="{DynamicResource LavendersFont}"
             Opacity="0"
             RenderTransformOrigin="0.5,0.5">

    <UserControl.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource ScalePop}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Border Margin="5"
            Cursor="Hand"
            MouseLeftButtonUp="DaySurface_MouseLeftButtonUp"
            Style="{DynamicResource LavenderDayCellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="2,0,2,9">
                <TextBlock Text="{Binding Header}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LavenderMutedTextBrush}"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd}'}"
                           FontWeight="SemiBold"
                           FontSize="21"
                           Foreground="{DynamicResource LavenderDeepBrush}"
                           HorizontalAlignment="Left"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Events}"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:Event}">
                            <Button HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    Background="{DynamicResource LavenderEventSurfaceBrush}"
                                    BorderThickness="0"
                                    Padding="10,6"
                                    MinHeight="58"
                                    Margin="0,0,0,7"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}, Path=DataContext.EditEventCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource HoverGlow}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="EventBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EventBorder" Property="Background" Value="{DynamicResource LavenderSoftBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="EventBorder" Property="Opacity" Value="0.82"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel>
                                    <TextBlock Text="{Binding StartDateTime, StringFormat='{}{0:HH:mm}'}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource LavenderDeepBrush}"
                                               Margin="0,0,0,2"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource LavenderTextBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="38"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource LavenderMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="34"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
