<Window x:Class="Lavenders.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Width="410" Height="250" Background="Transparent"
        FontFamily="{DynamicResource LavendersFont}" Topmost="True">
    <Border Background="{DynamicResource LavenderCardBrush}" CornerRadius="22" Padding="32"
            BorderBrush="{DynamicResource LavenderBorderBrush}" BorderThickness="1"
            Effect="{StaticResource SoftLavenderShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="22"
                        Background="{DynamicResource LavenderMistBrush}">
                    <Image Source="pack://application:,,,/Assets/Lavenders.ico"
                           Width="56" Height="56" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"/>
                </Border>
                <TextBlock Text="Lavenders" Margin="0,16,0,3" FontSize="24"
                           FontWeight="SemiBold" Foreground="{DynamicResource LavenderDeepBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource SplashPreparing}"
                           FontSize="13" Foreground="{DynamicResource LavenderMutedTextBrush}"/>
            </StackPanel>
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="6"
                         Foreground="{DynamicResource LavenderPrimaryBrush}"
                         Background="{DynamicResource LavenderMistBrush}"/>
        </Grid>
    </Border>
</Window>
