<UserControl x:Class="Lavenders.UI.Views.WeekViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lavenders.UI.ViewModels"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:views="clr-namespace:Lavenders.UI.Views"
             Background="Transparent"
             FontFamily="{DynamicResource LavendersFont}"
             PreviewMouseWheel="WeekViewControl_PreviewMouseWheel"
             TextElement.Foreground="{DynamicResource LavenderTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource LavenderCardBrush}" CornerRadius="16" Padding="14"
                Effect="{StaticResource SoftLavenderShadow}" Opacity="0">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource SlideDown}"/>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding PreviousWeekCommand}"
                        Style="{DynamicResource LavenderNavigationButton}" ToolTip="{DynamicResource PreviousWeek}">
                    <fa:IconBlock Icon="ChevronLeft" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MonthLabel}" FontWeight="SemiBold" FontSize="19"
                               TextWrapping="NoWrap" TextAlignment="Center"
                               Foreground="{DynamicResource LavenderDeepBrush}"/>
                    <TextBlock Text="{Binding IsoWeekLabel}" FontSize="12" FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="{DynamicResource LavenderMutedTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding NextWeekCommand}"
                        Style="{DynamicResource LavenderNavigationButton}" ToolTip="{DynamicResource NextWeek}">
                    <fa:IconBlock Icon="ChevronRight" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="3" Command="{Binding TodayCommand}"
                        Style="{DynamicResource LavenderNavigationButton}"
                        Width="44" Height="44" MinHeight="44" Padding="0" Margin="10,0,0,0"
                        ToolTip="{DynamicResource Today}">
                    <fa:IconBlock Icon="Calendar" FontSize="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="5" Command="{Binding AddEventCommand}"
                        Style="{DynamicResource LavenderWeekActionButton}"
                        MinWidth="160" Height="44" Padding="18,0"
                        VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <fa:IconBlock Grid.Column="0" Icon="Plus" FontSize="15"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource AddEvent}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekOneDays}" Opacity="0">
                <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="{Binding DayColumnCount}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded"><BeginStoryboard Storyboard="{StaticResource SlideUp}"/></EventTrigger>
                </ItemsControl.Triggers>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayViewModel}"><views:DayViewControl/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekTwoDays}" Opacity="0">
                <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="{Binding DayColumnCount}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded"><BeginStoryboard Storyboard="{StaticResource SlideUp}"/></EventTrigger>
                </ItemsControl.Triggers>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayViewModel}"><views:DayViewControl/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.RowSpan="2" Background="{DynamicResource LavenderLoadingOverlayBrush}"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="170" Height="8"
                                 Foreground="{DynamicResource LavenderDeepBrush}"
                                 Background="{DynamicResource LavenderBorderBrush}"/>
                    <TextBlock Text="{DynamicResource LoadingCalendar}" Margin="0,12,0,0"
                               FontWeight="SemiBold" Foreground="{DynamicResource LavenderMutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" Padding="14,10"
                MinWidth="280" MaxWidth="390"
                Panel.ZIndex="20"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Focusable="False">
            <Border.RenderTransform><TranslateTransform Y="28"/></Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Background" Value="{DynamicResource LavenderSuccessSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LavenderSuccessBorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LavenderErrorSurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LavenderErrorBorderBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource SoftEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         To="28" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel IsHitTestVisible="False">
                <TextBlock Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource LavenderSuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource LavenderDangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource LavenderMutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
